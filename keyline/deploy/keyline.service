[Unit]
Description=Keyline messenger
After=network-online.target
Wants=network-online.target

[Service]
User=keyline
WorkingDirectory=/opt/keyline
EnvironmentFile=/etc/keyline/env
Environment=HOST=127.0.0.1 PORT=8787 DATA_DIR=/var/lib/keyline TRUST_PROXY=1
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/keyline
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
